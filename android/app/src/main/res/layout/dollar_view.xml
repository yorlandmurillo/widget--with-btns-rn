<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Label -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/dot" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:letterSpacing="0.08"
            android:text="@string/widget_title"
            android:textColor="@color/widget_text_2"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Rate (same id as before) -->
    <TextView
        android:id="@+id/dolarValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="—"
        android:textColor="@color/widget_text"
        android:textSize="34sp" />

    <!-- Loading (same id as before) -->
    <TextView
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Cargando…"
        android:textColor="@color/widget_text_2"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0" />

    <!-- Counter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/counter_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/counterTimes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Chequeados: 0"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnAction"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_count"
            android:contentDescription="@string/click_button"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
        />
        </LinearLayout>
    </LinearLayout>